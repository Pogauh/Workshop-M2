# NOMS des variables attendues par docker-compose.yml. Les VALEURS vivent dans un .env local
# généré par scripts/gen_secrets.sh (ou scripts\windows\gen_secrets.ps1) — jamais commité.
POSTGRES_PASSWORD=
API_DB_PASSWORD=
AUTH_DB_PASSWORD=
JWT_SECRET=
INTERNAL_TOKEN=
ACTUATOR_TOKEN=
EVENT_HMAC_KEY=
GRAFANA_PASSWORD=
DEMO_PASSWORD=
WEAK_PASSWORD=
ATTACKER_PASSWORD=
PROBE_PASSWORD=

# Réglages non secrets (facultatifs) :
# true seulement si la vérification scripts/check_source_ip.sh confirme que le WAF voit la vraie IP source de l'attaquant
TRUST_SOURCE_IP=false
# IP à ne jamais bannir (séparées par des virgules)
NEVER_BAN=
TRAFFIC_RPS=4
ASSISTANT_CHAT_MODEL=qwen2.5:3b-instruct
ASSISTANT_EMBED_MODEL=nomic-embed-text
